# ─── Vercel Environment Variables ────────────────────────────
# Bu qiymatlar Vercel loyihasining Settings → Environment Variables
# bo'limiga qo'shiladi (Production, Preview va Development uchun).
# Bu fayl namuna — haqiqiy qiymatlar hech qachon git'ga tushmaydi.
#
# Mahalliy ishlab chiqish uchun xuddi shu qiymatlarni `.env.local`
# fayliga yozing — `vite dev` ularni `api/*` funksiyalariga uzatadi.

# ─── Majburiy ────────────────────────────────────────────────

# Telegram bot tokeni. initData imzosi shu bilan tekshiriladi —
# ya'ni bu token butun autentifikatsiyaning kalitidir. Sizib chiqsa,
# istalgan odam istalgan foydalanuvchi nomidan kira oladi.
BOT_TOKEN=

# Firebase service account JSON — BUTUNLIGICHA, bitta qatorda.
# Firebase Console → Project Settings → Service accounts →
# "Generate new private key" tugmasi bilan olinadi.
# Faylni ochib, ichidagi JSON'ni to'liq nusxalang.
FIREBASE_SERVICE_ACCOUNT=


# ─── Admin panel (/admin) ────────────────────────────────────

# Panelga kirish logini.
ADMIN_USERNAME=

# Parolning scrypt hash'i — ochiq parol hech qayerda saqlanmaydi.
# Yangi hash yasash:
#   node -e "const{randomBytes,scryptSync}=require('crypto');const p=process.argv[1];const s=randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+scryptSync(p,s,32).toString('hex'))" "PAROLINGIZ"
# Panelning "Sozlamalar → Xavfsizlik" bo'limidan parol o'zgartirilsa,
# yangi hash Firestore'ga yoziladi va shu qiymatdan ustun turadi.
ADMIN_PASSWORD_HASH=

# Sessiya cookie'sini imzolash kaliti. Istalgan uzun tasodifiy satr:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# O'zgartirilsa, ochiq sessiyalarning hammasi bekor bo'ladi.
ADMIN_SESSION_SECRET=

# Yangi buyurtma va chek haqida Telegram xabarini kim oladi.
# Bir nechta bo'lsa vergul bilan: 123456,789012
# Bot tomonidagi nusxasi: bot/config.py → ADMIN_IDS
ADMIN_TELEGRAM_IDS=


# ─── Ixtiyoriy ───────────────────────────────────────────────

# Mahsulot rasmlari shu bucket'ga yuklanadi. Ko'rsatilmasa
# uj-vision-kiyimdokon.firebasestorage.app ishlatiladi.
FIREBASE_STORAGE_BUCKET=

# Xabarlardagi "Panelda ochish" tugmasi shu manzilga olib boradi.
# Ko'rsatilmasa https://uj-vision.vercel.app ishlatiladi.
PUBLIC_APP_URL=


# ─── Env'da BO'LMAYDIGAN qiymatlar ───────────────────────────
# Quyidagilar ataylab env'da emas — ular maxfiy emas va bitta
# fayldan o'qiladi:
#
#   Firebase web config (apiKey, projectId, ...) → src/config/firebase.ts
#   Bot username, telefon, email, Telegram        → src/config/brand.ts
#   Bot tokeni (maxfiy!)                          → bot/.env
#   Mini app domeni, adminlar, karta, bucket      → bot/config.py
#
# To'liq ro'yxat: DEPLOY.md → "0. UJ VISION ga o'tish".
